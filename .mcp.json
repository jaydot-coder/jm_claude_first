{
  "mcpServers": {
    "korean-law": {
      "command": "npx",
      "args": ["-y", "korean-law-mcp@4.9.6"],
      "env": {
        "LAW_OC": "${LAW_OC}"
      },
      "timeout": 180000
    },
    "taxlaw-nts": {
      "command": "node",
      "args": ["${CLAUDE_PROJECT_DIR:-.}/mcp/node_modules/taxlaw-nts-mcp/build/index.js"],
      "timeout": 180000
    }
  }
}
